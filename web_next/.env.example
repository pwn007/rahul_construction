# Data source. `mock` runs entirely off src/data/* + localStorage (no backend).
# Flip to `http` to talk to the Laravel API in ../backend.
NEXT_PUBLIC_API_MODE=mock

# Where the Laravel API lives. /admin's sign-in always uses this, even in mock
# mode. Dev: http://localhost:8000/api (php artisan serve). Production:
# /backend/public/api — same origin (Laravel lives inside public_html/backend
# and its public/ folder is served directly; the host's LiteSpeed refused every
# internal-rewrite route to a cleaner /api, see public/.htaccess).
NEXT_PUBLIC_API_URL=/api

# Absolute origin. Used for canonical URLs, the sitemap, and as the base for
# relative API URLs during server rendering (where window.location does not exist).
NEXT_PUBLIC_SITE_URL=https://www.neetuarchstone.com

# Google Tag Manager container. Analytics is inert when this is unset.
NEXT_PUBLIC_GTM_ID=

# Data transport.
#   mock — local seed data + localStorage overlay (default, no backend required)
#   http — talk to the Express API in /server
VITE_API_MODE=mock

# Only used when VITE_API_MODE=http.
# In dev, "/api" is proxied to http://localhost:4000 by vite.config.ts.
VITE_API_URL=/api

# Demo gate for /admin. NOT a secret — Vite inlines this into the client bundle
# at build time, so treat it as a doormat, not a lock. See
# src/features/admin/AdminGate.tsx. Defaults to "archstone" when unset.
VITE_ADMIN_PASSCODE=archstone
